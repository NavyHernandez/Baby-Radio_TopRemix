<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BebeRadio.Controls.MasterFaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:fluent="using:FluentIcons.WinUI">

    <!--
        Fader maestro horizontal estilo crossfader Pioneer DJM (mixer físico).
        Ocupa el ancho del VU (Stretch): el padre lo apila sobre el VU.
        Template COMPLETO del Slider (DjCrossfaderStyle): cero cromo nativo de
        Windows — solo ranura fresada + cap DJM (negro mate, grips laterales,
        línea blanca central) + escala dB serigrafiada (0/-6/-12/-20/-40,
        curva cuadrática del VM) + botón mute + % en Cascadia Mono.
        El template conserva las partes que el Slider busca por nombre
        (HorizontalThumb/TrackRect/DecreaseRect + TickBars) para no romper
        arrastre, clic-en-pista, flechas del teclado ni accesibilidad UIA.
        Colores solo vía {StaticResource}. Sin lógica de audio: todo va al
        PlayerViewModel (curva cuadrática + persistencia).
    -->
    <UserControl.Resources>
        <!-- Crossfader DJ: template total, sin pista nativa (local al control).
             Respeta la estructura del template nativo (3 columnas + thumb en la
             central): es lo que le permite al Slider desplazar el cap en todo
             el ancho según Value. Partes por nombre conservadas. -->
        <Style x:Key="DjCrossfaderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="LayoutRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="LayoutRoot"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.4"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="FocoRanura"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="OrientationStates">
                                    <VisualState x:Name="Horizontal" />
                                    <VisualState x:Name="Vertical">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="HorizontalTemplate"
                                                Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="VerticalTemplate"
                                                Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Plantilla horizontal: Grid de 3 columnas como el template
                                 nativo (decremento / cap / resto). El motor del Slider
                                 desplaza el cap redimensionando las columnas laterales
                                 según Value; sin columnas el thumb quedaba clavado. -->
                            <Grid x:Name="HorizontalTemplate" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Ranura fresada en la placa + filo de luz -->
                                <StackPanel
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    VerticalAlignment="Center">
                                    <Border
                                        Height="6"
                                        Background="{StaticResource BottomEdge}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="3" />
                                    <Border
                                        Height="1"
                                        Margin="4,1,4,0"
                                        Background="{StaticResource HighlightTop}"
                                        Opacity="0.6" />
                                </StackPanel>
                                <!-- Anillo de foco para teclado (flechas + Tab) -->
                                <Border
                                    x:Name="FocoRanura"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource CategoryMusic}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                                <!-- Medida de pista (invisible): el Slider calcula aquí -->
                                <Border
                                    x:Name="HorizontalTrackRect"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Background="Transparent" />
                                <!-- Sin fill (mixer real: manda el cap contra la escala) -->
                                <Rectangle
                                    x:Name="HorizontalDecreaseRect"
                                    Grid.Column="0"
                                    Height="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="Transparent" />
                                <!-- TickBars exigidos por el Slider (ocultos) -->
                                <TickBar
                                    x:Name="TopTickBar"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Fill="Transparent"
                                    Visibility="Collapsed" />
                                <TickBar
                                    x:Name="HorizontalInlineTickBar"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Fill="Transparent"
                                    Visibility="Collapsed" />
                                <TickBar
                                    x:Name="BottomTickBar"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Fill="Transparent"
                                    Visibility="Collapsed" />
                                <!-- Cap crossfader Pioneer DJM (celda central: el motor lo desplaza con las columnas) -->
                                <Thumb
                                    x:Name="HorizontalThumb"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                                <Grid Width="32" Height="22">
                                                    <!-- Sombra inferior del cap -->
                                                    <Border
                                                        Margin="2,4,2,0"
                                                        CornerRadius="2"
                                                        Background="{StaticResource BottomEdge}"
                                                        Opacity="0.6" />
                                                    <!-- Cuerpo negro mate -->
                                                    <Border
                                                        Background="{StaticResource BackgroundCardPressed}"
                                                        BorderBrush="{StaticResource BorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                        <Grid>
                                                            <!-- Sheen superior -->
                                                            <Border
                                                                Height="1"
                                                                Margin="3,1,3,0"
                                                                VerticalAlignment="Top"
                                                                Background="{StaticResource HighlightTop}" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Grip izquierdo -->
                                                                <StackPanel
                                                                    Grid.Column="0"
                                                                    Margin="4,0,0,0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center">
                                                                    <Border
                                                                        Width="1"
                                                                        Height="12"
                                                                        Background="{StaticResource BorderSubtle}" />
                                                                    <Border
                                                                        Width="1"
                                                                        Height="12"
                                                                        Background="{StaticResource BorderSubtle}" />
                                                                    <Border
                                                                        Width="1"
                                                                        Height="12"
                                                                        Background="{StaticResource BorderSubtle}" />
                                                                </StackPanel>
                                                                <!-- Línea blanca central -->
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Width="2"
                                                                    Margin="0,3"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{StaticResource HoverOverlay}"
                                                                    CornerRadius="1"
                                                                    Opacity="0.9" />
                                                                <!-- Grip derecho -->
                                                                <StackPanel
                                                                    Grid.Column="2"
                                                                    Margin="0,0,4,0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center">
                                                                    <Border
                                                                        Width="1"
                                                                        Height="12"
                                                                        Background="{StaticResource BorderSubtle}" />
                                                                    <Border
                                                                        Width="1"
                                                                        Height="12"
                                                                        Background="{StaticResource BorderSubtle}" />
                                                                    <Border
                                                                        Width="1"
                                                                        Height="12"
                                                                        Background="{StaticResource BorderSubtle}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <!-- Hundido al agarrar -->
                                                            <Border
                                                                x:Name="CapPressed"
                                                                CornerRadius="2"
                                                                Background="{StaticResource PressedOverlay}"
                                                                Opacity="0" />
                                                        </Grid>
                                                    </Border>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver" />
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="CapPressed"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled" />
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Grid>
                                            </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>

                            <!-- Plantilla vertical: colapsada (respaldo de partes) -->
                            <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                                <Border x:Name="VerticalTrackRect" Background="Transparent" />
                                <Rectangle x:Name="VerticalDecreaseRect" Fill="Transparent" />
                                <TickBar
                                    x:Name="LeftTickBar"
                                    Fill="Transparent"
                                    Visibility="Collapsed" />
                                <TickBar
                                    x:Name="VerticalInlineTickBar"
                                    Fill="Transparent"
                                    Visibility="Collapsed" />
                                <TickBar
                                    x:Name="RightTickBar"
                                    Fill="Transparent"
                                    Visibility="Collapsed" />
                                <Thumb x:Name="VerticalThumb" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <controls:BoolAVisibilidadConverter x:Key="MuteVisible" Invertir="False" />
        <controls:BoolAVisibilidadConverter x:Key="SonidoVisible" Invertir="True" />
    </UserControl.Resources>

    <!-- Sin caja propia: fondo fusionado con el panel (BackgroundPanel) y sin borde -->
    <Border
        Background="{StaticResource BackgroundPanel}"
        Padding="6,2">
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mute: restaura al previo (ver PlayerViewModel.ToggleMute) -->
            <Button
                Grid.Column="0"
                Width="28"
                Height="28"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Silenciar o restaurar volumen maestro"
                Background="{StaticResource BackgroundCard}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                Command="{x:Bind ViewModel.ToggleMuteCommand, Mode=OneWay}"
                CornerRadius="14">
                <Grid>
                    <fluent:SymbolIcon
                        FontSize="14"
                        Foreground="{StaticResource TextPrimary}"
                        Symbol="Speaker2"
                        Visibility="{x:Bind ViewModel.EstaSilenciado, Mode=OneWay, Converter={StaticResource SonidoVisible}}" />
                    <fluent:SymbolIcon
                        FontSize="14"
                        Foreground="{StaticResource StateOnAir}"
                        Symbol="SpeakerMute"
                        Visibility="{x:Bind ViewModel.EstaSilenciado, Mode=OneWay, Converter={StaticResource MuteVisible}}" />
                </Grid>
            </Button>

            <!-- Fader: escala dB + crossfader -->
            <Grid Grid.Column="1" RowSpacing="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Escala serigrafiada (posiciones de la curva cuadrática) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*" />
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="25*" />
                        <ColumnDefinition Width="14*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="8"
                        Foreground="{StaticResource TextDisabled}"
                        Text="-40" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="8"
                        Foreground="{StaticResource TextDisabled}"
                        Text="-20" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="8"
                        Foreground="{StaticResource TextDisabled}"
                        Text="-12" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="8"
                        Foreground="{StaticResource TextDisabled}"
                        Text="-6" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="8"
                        Foreground="{StaticResource TextSecondary}"
                        Text="0" />
                </Grid>

                <!-- Crossfader (template DJ, sin cromo Windows) -->
                <Slider
                    Grid.Row="1"
                    Height="32"
                    AutomationProperties.Name="Volumen maestro"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    Style="{StaticResource DjCrossfaderStyle}"
                    Value="{x:Bind ViewModel.VolumenMaestroPorciento, Mode=TwoWay}" />
            </Grid>

            <!-- Lectura % monoespaciada -->
            <TextBlock
                Grid.Column="2"
                MinWidth="40"
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="11"
                Foreground="{StaticResource TextSecondary}"
                Text="{x:Bind ViewModel.TextoVolumen, Mode=OneWay}"
                TextAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
