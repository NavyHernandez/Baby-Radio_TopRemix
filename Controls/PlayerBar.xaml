<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BebeRadio.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:fluent="using:FluentIcons.WinUI">

    <!--
        Barra de reproductor (~140px). Dirige la cola con audio real.
        Transporte + progreso/tiempos + VU estéreo debajo (junto al progreso).
        Iconografía solo FluentIcons.WinUI; tiempos en Cascadia Mono.
    -->
    <UserControl.Resources>
        <controls:TextoAVisibilidadConverter x:Key="AvisoVisibilidad" />
    </UserControl.Resources>
    <Border
        Background="{StaticResource VuTrack}"
        BorderBrush="{StaticResource BorderSubtle}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="8,4">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Mini-pantalla digital en grilla (mapa de celdas):
                 F1: A1·B1 libres + C1 = reloj+fecha (der/sup) ·
                 F2: título span 3 (marquee) · F3: artista span 3 ·
                 F4: avisos span 3 (solo si hay) · LIBRES: A1, B1. -->
            <Border
                Grid.Column="0"
                Padding="8,4"
                VerticalAlignment="Stretch"
                Background="{StaticResource VuTrack}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Top"
                        Fill="{StaticResource PressedOverlay}" />
                    <!-- Fila 1: aire (A1, B1 libres) + reloj C1 -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="0" VerticalAlignment="Top">
                        <TextBlock
                            x:Name="RelojTexto"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Reloj"
                            FontFamily="Consolas"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DigitalAmber}"
                            Text="00:00:00" />
                        <TextBlock
                            x:Name="FechaTexto"
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{StaticResource TextSecondary}"
                            Text="01/01" />
                    </StackPanel>
                    <!-- Fila 2: título a todo el ancho (marquee) -->
                    <Grid x:Name="TituloContenedor" Grid.Row="1" Grid.ColumnSpan="3">
                        <TextBlock
                            x:Name="TituloTexto"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DigitalAmber}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TituloDesplazamiento" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <!-- Fila 3: artista a todo el ancho -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        FontSize="11"
                        Foreground="{StaticResource DisplaySecondary}"
                        Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <!-- Fila 4: avisos (colapsada si vacía) -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="3"
                        FontSize="10"
                        Foreground="{StaticResource CategoryCommercial}"
                        Text="{x:Bind ViewModel.Aviso, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.Aviso, Mode=OneWay, Converter={StaticResource AvisoVisibilidad}}" />
                </Grid>
            </Border>

            <!-- Zona centro: transporte (5 pads) + progreso/tiempos + VU debajo -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <!-- Previous · Play/Pausa (60px) · Stop · Next · Repeat 🔁 · StopAtEnd 🏁
                     (toggles armados con glow: repetir re-empieza; 🏁 detiene al terminar) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Button
                        x:Name="PreviousButton"
                        AutomationProperties.Name="Pista anterior"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="Previous" />
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        Width="60"
                        Height="60"
                        AutomationProperties.Name="Reproducir o pausar"
                        Command="{x:Bind ViewModel.TogglePlayCommand}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <Grid>
                            <fluent:SymbolIcon
                                x:Name="PlayIcon"
                                Foreground="{StaticResource TextPrimary}"
                                Symbol="Play" />
                            <fluent:SymbolIcon
                                x:Name="PauseIcon"
                                Foreground="{StaticResource TextPrimary}"
                                Symbol="Pause"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="StopButton"
                        AutomationProperties.Name="Detener"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Click="OnStopClick"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="Stop" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        AutomationProperties.Name="Siguiente pista"
                        Command="{x:Bind ViewModel.NextCommand}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="Next" />
                    </Button>
                    <Button
                        x:Name="RepeatButton"
                        AutomationProperties.Name="Repetir pista actual"
                        Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                        controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryMusic}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="ArrowRepeatAll" />
                    </Button>
                    <Button
                        x:Name="StopAtEndButton"
                        AutomationProperties.Name="Detener al terminar la pista"
                        Command="{x:Bind ViewModel.ToggleStopAtEndCommand}"
                        controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryCommercial}"
                        controls:BebeButtonHelper.IsActive="{x:Bind ViewModel.StopAtEndArmed, Mode=OneWay}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="FlagCheckered" />
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="10"
                        Foreground="{StaticResource TextPrimary}"
                        Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                    <ProgressBar
                        Grid.Column="1"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{StaticResource BorderSubtle}"
                        Foreground="{StaticResource CategoryMusic}"
                        Maximum="1"
                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondary}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
                </Grid>
                <!-- VU estéreo (200×32): lo alimenta el VM a 20 Hz vía code-behind -->
                <controls:VuMeterControl x:Name="VuMeter" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
