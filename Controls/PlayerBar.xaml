<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BebeRadio.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:fluent="using:FluentIcons.WinUI">

    <!--
        Barra de reproductor compacta: 60 % transporte (pads 52, play 60,
        repartidos) + progreso, 40 % VU estéreo. Fondo fusionado.
        La mini-pantalla vive sobre la lista (MiniPantallaControl).
        Iconografía solo FluentIcons.WinUI; tiempos en Cascadia Mono.
    -->
    <Border
        Background="{StaticResource BackgroundPanel}"
        BorderBrush="{StaticResource BorderSubtle}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="8,4">
        <!-- 60 % transporte + progreso · 40 % vúmetro -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Transporte (6 pads) + progreso/tiempos -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <!-- Previous · Play/Pausa (60px) · Stop · Next · Repeat 🔁 · StopAtEnd 🏁
                     (toggles armados con glow: repetir re-empieza; 🏁 detiene al terminar) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <Button
                        x:Name="PreviousButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Pista anterior"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="Previous" />
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        Width="60"
                        Height="60"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Reproducir o pausar"
                        Command="{x:Bind ViewModel.TogglePlayCommand}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <Grid>
                            <fluent:SymbolIcon
                                x:Name="PlayIcon"
                                Foreground="{StaticResource TextPrimary}"
                                Symbol="Play" />
                            <fluent:SymbolIcon
                                x:Name="PauseIcon"
                                Foreground="{StaticResource TextPrimary}"
                                Symbol="Pause"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="StopButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Detener"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Click="OnStopClick"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="Stop" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Siguiente pista"
                        Command="{x:Bind ViewModel.NextCommand}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="Next" />
                    </Button>
                    <Button
                        x:Name="RepeatButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Repetir pista actual"
                        Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                        controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryMusic}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="ArrowRepeatAll" />
                    </Button>
                    <Button
                        x:Name="StopAtEndButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Detener al terminar la pista"
                        Command="{x:Bind ViewModel.ToggleStopAtEndCommand}"
                        controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryCommercial}"
                        controls:BebeButtonHelper.IsActive="{x:Bind ViewModel.StopAtEndArmed, Mode=OneWay}"
                        Style="{StaticResource BebeTransportButtonStyle}">
                        <fluent:SymbolIcon FontSize="20" Foreground="{StaticResource TextPrimary}" Symbol="FlagCheckered" />
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="10"
                        Foreground="{StaticResource TextPrimary}"
                        Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
                    <ProgressBar
                        Grid.Column="1"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{StaticResource BorderSubtle}"
                        Foreground="{StaticResource CategoryMusic}"
                        Maximum="1"
                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondary}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <!-- Web sobre el VU estéreo (lo alimenta el VM a 20 Hz vía code-behind) -->
            <StackPanel
                Grid.Column="1"
                Spacing="2"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource TextSecondary}"
                    AutomationProperties.Name="Web Top Remix"
                    Text="www.top-remix.com" />
                <controls:VuMeterControl
                    x:Name="VuMeter"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
