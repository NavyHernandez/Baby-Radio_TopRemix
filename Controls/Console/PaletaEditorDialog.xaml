<?xml version="1.0" encoding="utf-8" ?>
<!--
    PaletaEditorDialog — editor del slot de efecto (popup horizontal).
    Izq: datos + archivo + onda arrastrable con pre-escucha.
    Der: color libre, ganancia y fundidos. Letras chicas, dos columnas.
    Edita un borrador: solo Guardar toca el slot real.
-->
<ContentDialog
    x:Class="BebeRadio.Controls.Console.PaletaEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="using:BebeRadio.Controls.Console"
    xmlns:controls="using:BebeRadio.Controls"
    Title="Editar efecto"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    Width="780"
    Style="{StaticResource BebeDialogStyle}">

    <ContentDialog.Resources>
        <controls:CategoryBrushConverter x:Key="CategoryBrush" />
        <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
    </ContentDialog.Resources>

    <!-- Formulario horizontal: datos+onda | color+mezcla -->
    <ScrollViewer MaxHeight="540">
        <StackPanel Spacing="8" Width="740">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="306" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: datos + archivo + onda -->
                <StackPanel Spacing="8">
                    <TextBox
                        Header="Título"
                        FontSize="13"
                        Text="{x:Bind Borrador.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Header="Archivo de audio"
                        FontSize="12"
                        IsReadOnly="True"
                        PlaceholderText="Sin archivo (mock)"
                        Text="{x:Bind Borrador.FilePath, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Examinar…" Click="OnExaminarClick" FontSize="12" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource TextSecondary}"
                            Text="o arrastra un audio" />
                    </StackPanel>
                    <Border
                        Padding="8"
                        AllowDrop="True"
                        Background="{StaticResource BackgroundCard}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        DragOver="OnArchivoDragOver"
                        Drop="OnArchivoDrop">
                        <console:OndaEfectoControl x:Name="Onda" />
                    </Border>
                    <Slider
                        Header="Ganancia (dB)"
                        FontSize="12"
                        Minimum="-20"
                        Maximum="6"
                        StepFrequency="0.5"
                        Value="{x:Bind Borrador.GananciaDb, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            Header="Fund. entrada (s)"
                            FontSize="12"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind FundidoEntradaSegundos, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            Header="Fund. salida (s)"
                            FontSize="12"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind FundidoSalidaSegundos, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Derecha: solo color -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <CheckBox
                        Content="Color automático"
                        FontSize="12"
                        IsChecked="{x:Bind EsColorAuto, Mode=TwoWay}" />
                    <GridView
                        x:Name="ColoresGrid"
                        MaxHeight="72"
                        IsEnabled="{x:Bind EsColorAutoNegado, Mode=OneWay}"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind ColoresPresets, Mode=OneTime}">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Ellipse
                                    Width="18"
                                    Height="18"
                                    Fill="{Binding Converter={StaticResource CategoryBrush}}" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <ColorPicker
                        x:Name="LibrePicker"
                        IsAlphaEnabled="False"
                        IsColorChannelTextInputVisible="False"
                        IsColorPreviewVisible="False"
                        IsEnabled="{x:Bind EsColorAutoNegado, Mode=OneWay}"
                        IsHexInputVisible="True" />
                </StackPanel>
            </Grid>
            <TextBlock
                x:Name="ErrorText"
                FontSize="11"
                Foreground="{StaticResource StateOnAir}"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
