<?xml version="1.0" encoding="utf-8" ?>
<!--
    SoporteDialog — contacto de soporte (popup moderno).
    QR de WhatsApp + botón directo. Sin QR muestra fallback.
-->
<ContentDialog
    x:Class="BebeRadio.Controls.Console.SoporteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.WinUI"
    Title="Soporte"
    CloseButtonText="Cerrar"
    DefaultButton="Close"
    Style="{StaticResource BebeDialogStyle}">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
    </ContentDialog.Resources>

    <!-- Soporte: QR + WhatsApp directo -->
    <StackPanel Spacing="10" MinWidth="300" HorizontalAlignment="Center">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="{StaticResource TextSecondary}"
            Text="Escanea o escribe directo" />
        <Border
            HorizontalAlignment="Center"
            Padding="8"
            Background="{StaticResource BackgroundCard}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid Width="140" Height="140">
                <Image x:Name="QrImage" ImageFailed="OnQrFailed" Stretch="Uniform" />
                <StackPanel
                    x:Name="QrFallback"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <fluent:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{StaticResource TextDisabled}"
                        Symbol="QrCode" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextDisabled}"
                        Text="QR pendiente" />
                </StackPanel>
            </Grid>
        </Border>
        <Button
            x:Name="ChatBoton"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Abrir WhatsApp directo"
            Click="OnChatClick"
            Content="WhatsApp directo" />
    </StackPanel>
</ContentDialog>
