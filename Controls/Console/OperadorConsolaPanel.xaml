<?xml version="1.0" encoding="utf-8" ?>
<!--
    OperadorConsolaPanel — pantalla del modo operador: dos bancos de paletas
    lado a lado (cada uno con su categoría y páginas propias, 5x5) + fader
    maestro amplio en la barra superior (mismo Reproductor que la consola
    normal: cola + efectos) + tira compacta de acciones
    (Config·Categorías·Stop·Mix) + botón para salir.
    Sin cola: solo categorías y paletas (estilo cartwall).
    La lógica vive en ConsolaViewModel; aquí solo composición y diálogos.
-->
<UserControl
    x:Class="BebeRadio.Controls.Console.OperadorConsolaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="using:BebeRadio.Controls.Console"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:fluent="using:FluentIcons.WinUI">

    <Grid RowSpacing="8" KeyDown="OnTecla">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superior: título + fader maestro amplio + salida -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimary}"
                Text="{x:Bind Consola.TituloOperador, Mode=OneWay}" />
            <!-- Fader maestro centrado al 50 % (mismo volumen total que la
                 consola normal: cola vía MotorAudio + efectos vía
                 MezcladorEfectos, con mute, curva cuadrática y persistencia
                 en PlayerViewModel). Las columnas laterales absorben el
                 50 % restante para que no ocupe todo el ancho. -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <controls:MasterFaderControl
                    Grid.Column="1"
                    MinWidth="320"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ViewModel="{x:Bind Consola.Reproductor, Mode=OneWay}" />
            </Grid>
            <Button
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                MinHeight="32"
                MinWidth="72"
                Padding="12,0"
                AutomationProperties.Name="Salir"
                Click="OnSalirClick"
                Style="{StaticResource BebeLightButtonStyle}"
                ToolTipService.ToolTip="Volver a la consola (Esc)">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource LightInk}"
                    Text="Salir" />
            </Button>
        </Grid>

        <!-- Uno o dos bancos independientes (según ajuste) -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColumnaA" Width="*" />
                <ColumnDefinition x:Name="ColumnaB" Width="*" />
            </Grid.ColumnDefinitions>
            <console:BancoOperadorPanel
                x:Name="BancoA"
                PaletaVM="{x:Bind Consola.PaletaA, Mode=OneWay}"
                Selector="{x:Bind Consola.SelectorA, Mode=OneWay}" />
            <console:BancoOperadorPanel
                x:Name="BancoB"
                Grid.Column="1"
                PaletaVM="{x:Bind Consola.PaletaB, Mode=OneWay}"
                Selector="{x:Bind Consola.SelectorB, Mode=OneWay}" />
        </Grid>

        <!-- Tira ancha: Config · Categorías · Stop · Mix (4 columnas * iguales) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                MinHeight="104"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Configuración"
                Click="OnConfigClick"
                controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryFiller}"
                Style="{StaticResource BebeLightButtonStyle}">
                <StackPanel Spacing="3">
                    <Grid HorizontalAlignment="Center">
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource PressedOverlay}" Margin="0,1,0,-1" Symbol="Settings" />
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource CategoryFiller}" Symbol="Settings" />
                    </Grid>
                    <Grid HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AluminumTop}" Margin="0,1,0,-1" Text="Config" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LightInk}" Text="Config" />
                    </Grid>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                MinHeight="104"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Gestionar categorías"
                Click="OnGestionarClick"
                controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryProgram}"
                Style="{StaticResource BebeLightButtonStyle}">
                <StackPanel Spacing="3">
                    <Grid HorizontalAlignment="Center">
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource PressedOverlay}" Margin="0,1,0,-1" Symbol="MusicNote2" />
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource CategoryProgram}" Symbol="MusicNote2" />
                    </Grid>
                    <Grid HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AluminumTop}" Margin="0,1,0,-1" Text="Categorías" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LightInk}" Text="Categorías" />
                    </Grid>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                MinHeight="104"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Detener efectos"
                Command="{x:Bind Consola.Acciones.DetenerCommand, Mode=OneWay}"
                Click="OnConsolaFlashClick"
                controls:BebeButtonHelper.CategoryColor="{StaticResource StateOnAir}"
                Style="{StaticResource BebeLightButtonStyle}"
                ToolTipService.ToolTip="Detener efectos de ambos bancos">
                <StackPanel Spacing="3">
                    <Grid HorizontalAlignment="Center">
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource PressedOverlay}" Margin="0,1,0,-1" Symbol="Stop" />
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource StateOnAir}" Symbol="Stop" />
                    </Grid>
                    <Grid HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AluminumTop}" Margin="0,1,0,-1" Text="Stop" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LightInk}" Text="Stop" />
                    </Grid>
                </StackPanel>
            </Button>
            <Button
                x:Name="MixButton"
                Grid.Column="3"
                MinHeight="104"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="Mezcla"
                Command="{x:Bind Consola.Acciones.ToggleMixCommand, Mode=OneWay}"
                controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryCommercial}"
                Style="{StaticResource BebeLightButtonStyle}"
                ToolTipService.ToolTip="Mezcla de efectos">
                <StackPanel Spacing="3">
                    <Grid HorizontalAlignment="Center">
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource PressedOverlay}" Margin="0,1,0,-1" Symbol="Options" />
                        <fluent:SymbolIcon HorizontalAlignment="Center" FontSize="30" Foreground="{StaticResource CategoryCommercial}" Symbol="Options" />
                    </Grid>
                    <Grid HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AluminumTop}" Margin="0,1,0,-1" Text="Mix" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LightInk}" Text="Mix" />
                    </Grid>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
