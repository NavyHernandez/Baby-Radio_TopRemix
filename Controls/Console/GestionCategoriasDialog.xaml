<?xml version="1.0" encoding="utf-8" ?>
<!--
    GestionCategoriasDialog — elige las 7 cargadas del riel.
    Filas con check (máx 7), orden ▲▼, Editar y Eliminar.
    + Nueva crea sin salir del flujo. Borrador hasta Guardar.
-->
<ContentDialog
    x:Class="BebeRadio.Controls.Console.GestionCategoriasDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:models="using:BebeRadio.Models"
    Title="Gestionar categorías"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    Style="{StaticResource BebeDialogStyle}">

    <ContentDialog.Resources>
        <controls:CategoryBrushConverter x:Key="CategoryBrush" />
        <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
    </ContentDialog.Resources>

    <!-- Gestor: nueva + aviso + lista -->
    <StackPanel Spacing="8" MinWidth="520">
        <Button
            HorizontalAlignment="Left"
            AutomationProperties.Name="Nueva categoría"
            Click="OnNuevaClick"
            Content="+ Nueva categoría" />
        <TextBlock
            FontSize="12"
            Foreground="{StaticResource TextSecondary}"
            Text="Marca las 7 cargadas en el riel (máximo 7)." />
        <TextBlock
            x:Name="AvisoText"
            FontSize="12"
            Foreground="{StaticResource CategoryCommercial}"
            Visibility="Collapsed"
            Text="Solo 7 pueden estar cargadas." />
        <ListView
            MaxHeight="380"
            ItemsSource="{x:Bind Filas, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FilaGestionCategoria">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Cargada en el riel"
                            IsChecked="{x:Bind Cargada, Mode=TwoWay}"
                            Checked="OnCargadaChanged"
                            Unchecked="OnCargadaChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Fill="{x:Bind BrushKey, Mode=OneWay, Converter={StaticResource CategoryBrush}}" />
                            <fluent:SymbolIcon FontSize="18" Symbol="{Binding Symbol}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind Label, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="3"
                            Padding="8,2"
                            AutomationProperties.Name="Subir"
                            CommandParameter="{x:Bind}"
                            Click="OnSubirClick"
                            Content="▲"
                            FontSize="10" />
                        <Button
                            Grid.Column="4"
                            Padding="8,2"
                            AutomationProperties.Name="Bajar"
                            CommandParameter="{x:Bind}"
                            Click="OnBajarClick"
                            Content="▼"
                            FontSize="10" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                            <Button
                                Padding="8,2"
                                AutomationProperties.Name="Editar categoría"
                                CommandParameter="{x:Bind}"
                                Click="OnEditarClick"
                                Content="Editar"
                                FontSize="11" />
                            <Button
                                Padding="8,2"
                                AutomationProperties.Name="Eliminar categoría"
                                CommandParameter="{x:Bind}"
                                Click="OnEliminarClick"
                                Content="Eliminar"
                                FontSize="11" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
