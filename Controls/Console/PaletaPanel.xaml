<?xml version="1.0" encoding="utf-8" ?>
<!--
    PaletaPanel — parrilla de 60 slots por categoría (30+30, centro).
    Sin mocks: el slot vacío es un fantasma elegante (tenue + guía) listo
    para llenar por arrastre o editor. Clic reproduce por el mezclador y el
    cart titila mientras suena (segundo clic lo detiene; sin audio pulso).
    Click derecho abre Editar/Limpiar. Exportar/importar vive en el riel
    (junto a Acerca de). Tiempos en Cascadia Mono.
    Marca de agua: el logo Baby Radio (mismo asset que la cola) vive DETRÁS
    de los carts, anclado al fondo; solo se ve en el hueco de la última
    página parcial (MaxItems del panel fija la fila a alto de página completa
    y el fondo opaco no pinta el sobrante). Fondo único BackgroundCard.
-->
<UserControl
    x:Class="BebeRadio.Controls.Console.PaletaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:fluent="using:FluentIcons.WinUI"
    xmlns:models="using:BebeRadio.Models"
    xmlns:local="using:BebeRadio.Support">

    <UserControl.Resources>
        <controls:CategoryBrushConverter x:Key="CategoryBrush" />
        <controls:SlotAEstiloConverter x:Key="SlotEstilo" />
        <controls:BoolAVisibilidadConverter x:Key="VacioVisible" Invertir="True" />
        <controls:BoolAVisibilidadConverter x:Key="SinCategoriaVisible" />
        <controls:BoolToOpacityConverter x:Key="LlenoOpaco" DimOpacity="0.85" />
    </UserControl.Resources>

    <!-- Paleta: grilla uniforme 5 col (reparte alto) sobre fondo único -->
    <Grid x:Name="RaizPaleta" Background="{StaticResource BackgroundCard}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <local:LayoutStateTrigger State="Compact" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PaletteList.(ItemsControl.ItemTemplate).(DataTemplate).(Button.MinHeight)" Value="72" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <local:LayoutStateTrigger State="Medium" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PaletteList.(ItemsControl.ItemTemplate).(DataTemplate).(Button.MinHeight)" Value="82" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers>
                        <local:LayoutStateTrigger State="Expanded" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PaletteList.(ItemsControl.ItemTemplate).(DataTemplate).(Button.MinHeight)" Value="96" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- Marca de agua al fondo (detrás de los carts): logo grande con los
             bordes ya difuminados del asset, mismo estilo que la cola. Anclada
             abajo y sin hit-test; el code-behind ajusta MaxHeight al hueco de
             la última página para que nunca lo recorte la parrilla. -->
        <Image
            x:Name="MarcaAgua"
            MaxWidth="520"
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0.55"
            Source="ms-appx:///Assets/Baby-Radio-Watermark.png"
            Stretch="Uniform"
            ToolTipService.ToolTip="Baby Radio" />
        <ItemsControl x:Name="PaletteList" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:UniformGridPanel
                        Columns="5"
                        Background="{StaticResource BackgroundCard}"
                        UseLayoutRounding="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:PaletteItem">
                    <Button
                        MinHeight="82"
                        HorizontalAlignment="Stretch"
                        AllowDrop="True"
                        AutomationProperties.Name="{Binding Title}"
                        Click="OnPaletteFlashClick"
                        DragOver="OnCartDragOver"
                        Drop="OnCartDrop"
                        Opacity="{Binding TieneAudio, Converter={StaticResource LlenoOpaco}}"
                        controls:BebeButtonHelper.CategoryColor="{Binding ColorFantasma, Converter={StaticResource CategoryBrush}}"
                        Style="{Binding TieneAudio, Converter={StaticResource SlotEstilo}}">
                        <Button.ContextFlyout>
                            <MenuFlyout Opening="OnCartMenuOpening">
                                <MenuFlyoutItem
                                    x:Name="CargarItem"
                                    CommandParameter="{Binding}"
                                    Text="Cargar audio…"
                                    Click="OnCargarAudioClick" />
                                <MenuFlyoutItem
                                    x:Name="EditarItem"
                                    CommandParameter="{Binding}"
                                    Text="Editar…"
                                    Click="OnEditarCartClick" />
                                <MenuFlyoutItem
                                    x:Name="MapeoItem"
                                    CommandParameter="{Binding}"
                                    Text="Mapeo…"
                                    Click="OnMapeoClick" />
                                <MenuFlyoutItem
                                    x:Name="LimpiarItem"
                                    CommandParameter="{Binding}"
                                    Text="Limpiar"
                                    Click="OnLimpiarCartClick" />
                                <!-- Guía: slots vacíos no abren acciones -->
                                <MenuFlyoutItem
                                    x:Name="GuiaItem"
                                    IsEnabled="False"
                                    Text="Arrastre un audio para cargar" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <StackPanel Spacing="3" Margin="0,4,0,4">
                            <!-- Guía fantasma: solo en slots vacíos -->
                            <fluent:SymbolIcon
                                HorizontalAlignment="Center"
                                FontSize="20"
                                Foreground="{StaticResource LightInk}"
                                Opacity="0.6"
                                Symbol="Add"
                                Visibility="{Binding TieneAudio, Converter={StaticResource VacioVisible}}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding TintaCart, Converter={StaticResource CategoryBrush}}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Foreground="{Binding TintaCart, Converter={StaticResource CategoryBrush}}"
                                Opacity="0.75"
                                Text="{Binding DisplayMeta}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Guía vacía: crear categoría es el primer paso del flujo -->
            <Border
                MinHeight="200"
                Padding="24"
                Background="{StaticResource BackgroundPanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.SinCategoria, Mode=OneWay, Converter={StaticResource SinCategoriaVisible}}">
                <StackPanel
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <fluent:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="28"
                        Foreground="{StaticResource TextDisabled}"
                        Symbol="Add" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="Sin categoría" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondary}"
                        Text="Cree una categoría primero: es el primer paso para llenar su paleta de efectos."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        MinHeight="40"
                        MinWidth="160"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Crear categoría"
                        Click="OnCrearCategoriaClick"
                        controls:BebeButtonHelper.CategoryColor="{StaticResource CategoryCommercial}"
                        Style="{StaticResource BebeLightButtonStyle}">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource LightInk}"
                            Text="Crear categoría" />
                    </Button>
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
