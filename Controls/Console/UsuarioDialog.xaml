<?xml version="1.0" encoding="utf-8" ?>
<!--
    UsuarioDialog — cuenta del operador (popup moderno).
    Alias + Guardar + web + pie de derechos (GH Dev Company).
-->
<ContentDialog
    x:Class="BebeRadio.Controls.Console.UsuarioDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mi cuenta"
    CloseButtonText="Cerrar"
    DefaultButton="Close"
    Style="{StaticResource BebeDialogStyle}">

    <ContentDialog.Resources>
        <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
    </ContentDialog.Resources>

    <!-- Cuenta: operador + acciones + derechos -->
    <StackPanel Spacing="10" MinWidth="300" HorizontalAlignment="Center">
        <TextBox
            x:Name="AliasBox"
            Header="Nombre o alias"
            MaxLength="24"
            PlaceholderText="Navy Mix Dj" />
        <Button
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Guardar perfil"
            Click="OnGuardarPerfilClick"
            Content="Guardar" />
        <HyperlinkButton
            HorizontalAlignment="Center"
            AutomationProperties.Name="Abrir web Top Remix"
            Click="OnWebClick"
            Content="www.top-remix.com"
            FontSize="12" />
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="11"
            Foreground="{StaticResource TextSecondary}"
            AutomationProperties.Name="Derechos reservados por GH Dev Company"
            Text="© Derechos reservados por GH Dev Company" />
    </StackPanel>
</ContentDialog>
