<?xml version="1.0" encoding="utf-8" ?>
<!--
    OndaEfectoControl — previsualizador de onda para cues (Win2D).
    Picos vía OndaPicos (NAudio), marcadores inicio/fin arrastrables,
    pre-escucha ▶/■ vía VistaPreviaAudio. Escribe directo al Borrador.
    Sin audio: estado vacío. Letras chicas (look moderno).
-->
<UserControl
    x:Class="BebeRadio.Controls.Console.OndaEfectoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:fluent="using:FluentIcons.WinUI">

    <!-- Onda: header (play + lecturas) + canvas + estados -->
    <StackPanel Spacing="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PlayBoton"
                Padding="6"
                AutomationProperties.Name="Pre-escuchar efecto"
                Click="OnPlayClick"
                IsEnabled="False">
                <fluent:SymbolIcon x:Name="PlayIcono" FontSize="14" Symbol="Play" />
            </Button>
            <TextBlock
                x:Name="InicioText"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="10"
                Foreground="{StaticResource TextSecondary}"
                Text="0:00.0 → 0:00.0" />
            <TextBlock
                x:Name="TotalText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="10"
                Foreground="{StaticResource TextDisabled}"
                Text="" />
        </Grid>
        <Grid>
            <canvas:CanvasControl
                x:Name="OndaCanvas"
                Height="104"
                HorizontalAlignment="Stretch"
                Draw="OnDraw" />
            <ProgressRing
                x:Name="Cargando"
                Width="28"
                Height="28"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="VacioText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource TextDisabled}"
                Text="Carga un audio para ver su onda"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</UserControl>
