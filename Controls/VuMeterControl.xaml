<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BebeRadio.Controls.VuMeterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <!-- VU consola 200×32: barras segmentadas + escala dB, 60 fps con vsync.
         Fuente: SetLevels(l, r) con niveles CRUDOS; la inercia dB vive en .xaml.cs.
         Colores vía paleta (VuGreen/Yellow/Red/Track, TextSecondary). -->
    <canvas:CanvasAnimatedControl
        x:Name="VuCanvas"
        Height="32"
        MinWidth="200"
        Draw="OnDraw"
        SizeChanged="OnSizeChanged"
        Update="OnUpdate" />
</UserControl>
