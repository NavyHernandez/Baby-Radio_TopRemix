<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BebeRadio.Controls">

    <!--
        Botones físico 3D estilo consola de mezcla (AGENTS.md §3.3).
        Capas (atrás→adelante): glow de actividad (sin hit-test), sombra GPU
        (code-behind, una vez en Loaded), cuerpo con gradiente cenital, tinte
        de categoría (carts), filo de luz superior + filo oscuro inferior,
        overlay de hundido, contenido (-1px en reposo, +2px en pressed).
        Estados: Normal · PointerOver (100ms) · Pressed (80ms) · Disabled ·
        Active/Inactive custom (grupo ActivityStates, vía IsActive).
        Estilos: BebeTransportButtonStyle (pads circulares con elipses) ·
        BebeCartButtonStyle (rectangular, CornerRadius 4) ·
        BebeLightButtonStyle (aluminio claro, tinta oscura).
        La sombra GPU se anexa con BebeButtonHelper.AttachShadow() en Loaded.
    -->

    <!-- Gradiente de transporte: más contraste (elemento principal de la UI) -->
    <LinearGradientBrush x:Key="TransportSurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#333943" />
        <GradientStop Offset="0.55" Color="#262B33" />
        <GradientStop Offset="1" Color="#1E2127" />
    </LinearGradientBrush>

    <!-- Sombra de luz invertida: simula hundido (oscuro arriba) en Pressed -->
    <LinearGradientBrush x:Key="PressedShadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#000000" />
        <GradientStop Offset="0.6" Color="#000000" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>

    <!-- Transporte circular: play / pausa / stop / siguiente -->
    <Style x:Key="BebeTransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="controls:BebeButtonHelper.IsCircular" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Ellipse
                            x:Name="GlowWash"
                            IsHitTestVisible="False"
                            Margin="-2"
                            Fill="{Binding Path=(controls:BebeButtonHelper.CategoryColor), RelativeSource={RelativeSource TemplatedParent}}"
                            Opacity="0" />
                        <Ellipse
                            x:Name="GlowBorder"
                            IsHitTestVisible="False"
                            Margin="-6"
                            Opacity="0"
                            Stroke="{Binding Path=(controls:BebeButtonHelper.CategoryColor), RelativeSource={RelativeSource TemplatedParent}}"
                            StrokeThickness="2" />
                        <!-- Pad DJ: aro elevado + plato cóncavo + specular (elipses: escalan) -->
                        <Ellipse
                            x:Name="SurfaceBorder"
                            Fill="{StaticResource TransportRimGradient}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="BevelLight"
                            Margin="1.5"
                            Opacity="0.9"
                            Stroke="{StaticResource HighlightTop}"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="Dish"
                            Margin="5"
                            Fill="{StaticResource TransportDishBrush}"
                            Stroke="{StaticResource BottomEdge}"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="Specular"
                            Width="26"
                            Height="12"
                            Margin="0,9,0,0"
                            VerticalAlignment="Top"
                            Fill="{StaticResource SpecularBrush}"
                            Opacity="0.5" />
                        <Ellipse
                            x:Name="HoverOverlay"
                            Margin="5"
                            Fill="{StaticResource HoverOverlay}"
                            Opacity="0" />
                        <Ellipse
                            x:Name="PressedShade"
                            Margin="5"
                            Fill="{StaticResource PressedShadeBrush}"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="Presenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimary}">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="PresenterShift" Y="-1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.1" />
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.1" />
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.03"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressedShade"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0:0:0.08" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Specular"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.08" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BevelLight"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.08" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PresenterShift"
                                            Storyboard.TargetProperty="Y"
                                            To="2"
                                            Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActivityStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Active" GeneratedDuration="0:0:0.1" />
                                    <VisualTransition To="Inactive" GeneratedDuration="0:0:0.15" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Inactive" />
                                <VisualState x:Name="Active">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.55"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.14"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

