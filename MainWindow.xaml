<?xml version="1.0" encoding="utf-8" ?>
<!--
    MainWindow — ventana principal: titlebar personalizada + Frame de navegación.
    El Frame carga Views/Phase1ShowcaseView (única pantalla de Fase 1).
    Backdrop Mica oscuro (ver AppWindow + ExtendsContentIntoTitleBar en .xaml.cs).
-->
<Window
    x:Class="BebeRadio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BebeRadio"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Baby Radio"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título personalizada (contenido extendido debajo).
             Icono PNG: ImageIconSource no soporta .ico; el icono de ventana
             real (.ico, taskbar) lo fija IconoVentana en el code-behind. -->
        <TitleBar x:Name="AppTitleBar" Title="Baby Radio">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Square44x44Logo.scale-200.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Anfitrión de páginas: el code-behind navega al showcase al arrancar -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
