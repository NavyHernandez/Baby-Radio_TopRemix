<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BebeRadio.Views.Phase1ShowcaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="using:BebeRadio.Controls.Console"
    xmlns:controls="using:BebeRadio.Controls"
    xmlns:local="using:BebeRadio.Support">

    <!--
        Consola Baby Radio Fase 1 (shell delgada, 3 columnas, sin scroll general):
        - Izq (320): ListaReproduccionPanel (cola + EN VIVO + drag&drop).
        - Centro (*): Grid Auto/*/Auto (PlayerBar + PaletaPanel 30 carts 5×6 que
          rellena + AccionesConsolaStrip 7 anclada al fondo en rectángulos verticales: alto
          proporcional al ancho vía ProporcionPanel, ver abajo).
        - Der (176): CategoriasRailPanel (7 fijas, sincronizada con paleta).
        La mezcla vive en ConsolaViewModel (ver ViewModels/Console/):
        categoría→paleta, acciones→lista. Esta vista no contiene lógica.
    -->
    <Grid x:Name="Raiz" Background="{StaticResource BackgroundBase}" Padding="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <local:LayoutStateTrigger State="Compact" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Raiz.Padding" Value="8" />
                        <Setter Target="LayoutNormal.(Grid.ColumnDefinitions)[0].Width" Value="280" />
                        <Setter Target="LayoutNormal.(Grid.ColumnDefinitions)[2].Width" Value="150" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <local:LayoutStateTrigger State="Medium" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Raiz.Padding" Value="12" />
                        <Setter Target="LayoutNormal.(Grid.ColumnDefinitions)[0].Width" Value="320" />
                        <Setter Target="LayoutNormal.(Grid.ColumnDefinitions)[2].Width" Value="176" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers>
                        <local:LayoutStateTrigger State="Expanded" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Raiz.Padding" Value="16" />
                        <Setter Target="LayoutNormal.(Grid.ColumnDefinitions)[0].Width" Value="380" />
                        <Setter Target="LayoutNormal.(Grid.ColumnDefinitions)[2].Width" Value="210" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <Grid x:Name="LayoutNormal" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="176" />
        </Grid.ColumnDefinitions>

        <!-- Parte 1: mini-pantalla + cola de reproducción -->
        <console:ListaReproduccionPanel
            Grid.Column="0"
            ViewModel="{x:Bind ViewModel.Lista, Mode=OneWay}"
            Reproductor="{x:Bind ViewModel.Reproductor, Mode=OneWay}" />

        <!-- Parte central: reproductor (Auto) + paleta (*) + tira de acciones
             (Auto, alto proporcional al ancho vía ProporcionPanel) anclada al fondo;
             así no queda hueco abajo. -->
        <Grid Grid.Column="1" RowSpacing="6">
            <!-- Reparto vertical RESPONSIVE:
                 · Fila 0 (PlayerBar): Auto, alto propio.
                 · Fila 1 (paleta): * (rellena lo que sobre).
                 · Fila 2 (tira de acciones): Auto; su alto lo dicta el
                   ProporcionPanel (abajo) a partir del ANCHO, así los botones
                   mantienen siempre forma de rectángulo vertical. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PlayerBar
                x:Name="Player"
                Grid.Row="0"
                ViewModel="{x:Bind ViewModel.Reproductor, Mode=OneWay}" />
            <console:PaletaPanel
                x:Name="Paleta"
                Grid.Row="1"
                PideNuevaCategoria="OnPideNuevaCategoria"
                ViewModel="{x:Bind ViewModel.Paleta, Mode=OneWay}" />
            <!-- Tira de 7 botones en rectángulos VERTICALES en cualquier pantalla:
                 alto de cada botón = (ancho de la columna / 7) × 1.25.
                 · AltoMinimo 96: piso para no recortar en ventanas bajas.
                 · FraccionAltoVentana 0.28: la tira nunca pasa del 28 % del alto
                   de la ventana (monitores ultra anchos).
                 · AltoMaximo 360: tope absoluto (4K / pantallas gigantes).
                 Para botones más/menos altos, ajustar solo RelacionAlto. -->
            <controls:ProporcionPanel
                Grid.Row="2"
                Margin="0,-4,0,0"
                AltoMaximo="360"
                AltoMinimo="96"
                Columnas="7"
                FraccionAltoVentana="0.28"
                RelacionAlto="1.25">
                <console:AccionesConsolaStrip
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ViewModel="{x:Bind ViewModel.Acciones, Mode=OneWay}" />
            </controls:ProporcionPanel>
        </Grid>

        <!-- Parte 4: riel de categorías -->
        <console:CategoriasRailPanel
            x:Name="Riel"
            Grid.Column="2"
            ConfiguracionImportada="OnConfiguracionImportada"
            ViewModel="{x:Bind ViewModel.Categorias, Mode=OneWay}" />
    </Grid>
    <!-- El panel operador se crea en código al primer ingreso (arranque intacto). -->
    </Grid>
</Page>
